# ATP environment configuration
# These variables are read by the atp binary when running locally or via CI.
# Copy this file to .env and adjust values for your deployment.

# Listen address (host:port)
ATP_ADDR=:8080

# Root directory for hosted apps, vault, and stores
ATP_ROOT=./data

# Master secret (at least 32 bytes, hex or base64)
# Generate with: head -c32 /dev/urandom | base64
ATP_SECRET=

# Enable encryption at rest for static and dynamic content
ATP_ENCRYPT=false

# Headless mode: serve apps/functions without the management view
ATP_HEADLESS=false

# Trusted proxy client-IP header (e.g. X-Forwarded-For)
ATP_CLIENT_IP_HEADER=

# Default document title for hosted applications
ATP_TITLE=

# Base URL of the pod service (overridden by --pod-url)
ATP_POD_URL=http://127.0.0.1:8081

# Base URL of the song service (overridden by --song-url)
ATP_SONG_URL=http://127.0.0.1:8082

# Base URL of the shepherd service (overridden by --shepherd-url)
ATP_SHEPHERD_URL=http://127.0.0.1:8083

# Shepherd admin token (sent as X-Shepherd-Admin)
# When empty, control is restricted to loopback clients
ATP_SHEPHERD_ADMIN=

# Auto-discover ATP instances on localhost and register their apps
ATP_DISCOVER=false

# Comma-separated list of ports for auto-discovery (overrides defaults)
# Defaults: 8080-8083, 9080, 9090
ATP_PORTS=

# Instance manifest for supervising pod/song/shepherd lifecycle
# Empty means use ./platform.json when present
ATP_MANIFEST=./platform.json

# Override the manifest's instance log directory
ATP_LOG_DIR=

# Supervise: start every manifest instance at startup and stop it on shutdown
ATP_SUPERVISE=false